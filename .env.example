# GEMINI_API_KEY: Optional for AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Backend Configuration
PORT=3000
FRONTEND_URL="http://localhost:3000"

# Supabase PostgreSQL & Auth Configuration
# If configured, MindBloom connects to your Supabase project.
# Otherwise, it runs seamlessly in self-contained demonstration mode with persistent memory store.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Frontend Vite Variables (Accessible client-side)
VITE_API_BASE_URL=""
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

